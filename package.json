{
  "name": "saarahs-fund",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "serve out --listen tcp://127.0.0.1:3000 --no-clipboard",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit --incremental false",
    "postbuild": "node scripts/normalize-export.mjs",
    "test": "node --test scripts/normalize-export.test.mjs",
    "verify:export": "node --test scripts/verify-export.test.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "^8",
    "serve": "14.2.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
